msgid "Wagtail table block"
msgstr "Wagtail tabellblock"

msgid "Row header"
msgstr "Radhuvud"

msgid "Table headers"
msgstr "Tabellrubriker"

msgid "Display the first row as a header"
msgstr "Visa första raden som rubrik"

msgid "Display the first column as a header"
msgstr "Visa första kolumnen som rubrik"

msgid "Column header"
msgstr "Kolumnhuvud"

msgid "Display the first row AND first column as headers"
msgstr "Visa första raden OCH första kolumnen som rubriker"

msgid "No headers"
msgstr "Inga rubriker"

msgid "Which cells should be displayed as headers?"
msgstr "Vilka celler ska visas som rubriker?"

msgid "Table caption"
msgstr "Tabelltext"

msgid ""
"A heading that identifies the overall topic of the table, and is useful for "
"screen reader users."
msgstr ""
"En rubrik som identifierar tabellens övergripande ämne och är användbar för "
"skärmläsaranvändare."

msgid "Table"
msgstr "Tabell"

msgid "Select a header option"
msgstr "Välj ett rubrikalternativ"
