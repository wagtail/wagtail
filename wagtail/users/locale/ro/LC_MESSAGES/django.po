msgstr "Da, atribuie"

msgid "No, don't assign"
msgstr "Nu, nu atribui"

#, python-format
msgid "Delete 1 user"
msgid_plural "Delete %(counter)s users"
msgstr[0] "Șterge 1 utilizator"
msgstr[1] "Șterge %(counter)s utilizatori"
msgstr[2] "Șterge %(counter)s de utilizatori"

msgid "Delete"
msgstr "Șterge"

msgid "Are you sure you want to delete these users?"
msgstr "Sigur doriți să ștergeți acești utilizatori?"

msgid "You don't have permission to delete this user"
msgid_plural "You don't have permission to delete these users"
msgstr[0] "Nu aveți permisiunea de a șterge acest utilizator"
msgstr[1] "Nu aveți permisiunea de a șterge acești utilizatori"
msgstr[2] "Nu aveți permisiunea de a șterge acești utilizatori"

msgid "Yes, delete"
msgstr "Da, șterge"

msgid "No, don't delete"
msgstr "Nu, nu șterge"

#, python-format
msgid "Change active state for 1 user"
msgid_plural "Change active state for %(counter)s users"
msgstr[0] "Schimbă starea activă pentru 1 utilizator"
msgstr[1] "Schimbă starea activă pentru %(counter)s utilizatori"
msgstr[2] "Schimbă starea activă pentru %(counter)s de utilizatori"

msgid "Set active state"
msgstr "Setează stare activă"

msgid "Are you sure you want to change the active state for these users?"
msgstr "Sigur doriți să schimbați starea activă pentru acești utilizatori?"

msgid "You cannot change your own active status"
msgstr "Nu vă puteți schimba propria stare activă"

msgid "Yes, change state"
msgstr "Da, schimbă starea"

msgid "No, don't change state"
msgstr "Nu, nu schimba starea"

