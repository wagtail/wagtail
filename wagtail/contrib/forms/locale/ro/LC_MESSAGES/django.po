#, python-format
msgid ""
"The name '%(duplicate_clean_name)s' is already assigned to this field and "
"cannot be changed. Please enter a different label for the conflicting field."
msgstr ""
"Numele '%(duplicate_clean_name)s' este deja atribuit acestui câmp și nu "
"poate fi schimbat. Introduceți o altă etichetă pentru câmpul aflat în "
"conflict."

#, python-format
msgid ""
"Field name '%(duplicate_clean_name)s' conflicts with another field. Please "
"change the label."
msgstr ""
"Numele de câmp '%(duplicate_clean_name)s' este în conflict cu alt câmp. "
"Schimbați eticheta."

