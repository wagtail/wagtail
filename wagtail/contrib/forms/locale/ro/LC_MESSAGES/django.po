msgstr "opțiuni"

msgid ""
"Comma or new line separated list of choices. Only applicable in checkboxes, "
"radio and dropdown."
msgstr ""
"Listă de opțiuni separate prin virgulă sau pe linii noi. Se aplică numai la "
"casete de bifat, butoane radio și liste derulante."

msgid "default value"
msgstr "valoare implicită"

msgid ""
"Default value. Comma or new line separated values supported for checkboxes."
msgstr ""
"Valoare implicită. Pentru casetele de bifat sunt acceptate valori separate "
"prin virgulă sau pe linii noi."

msgid "help text"
msgstr "text de ajutor"

msgid "Submission date"
msgstr "Data trimiterii"

msgid "Form"
msgstr "Formular"

msgid "Landing page"
msgstr "Pagină de destinație"

msgid "to address"
msgstr "adresa destinatarului"

msgid ""
"Optional - form submissions will be emailed to these addresses. Separate "
"multiple addresses by comma."
msgstr ""
"Opțional. Înregistrările de formular vor fi trimise prin e-mail la aceste "
"adrese. Separați adresele multiple prin virgulă."

msgid "from address"
msgstr "adresa expeditorului"

msgid "subject"
msgstr "subiect"

