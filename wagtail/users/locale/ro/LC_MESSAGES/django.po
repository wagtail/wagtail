msgid "Wagtail users"
msgstr "Utilizatori Wagtail"

msgid "Required. Letters, digits and @/./+/-/_ only."
msgstr "Obligatoriu. Numai litere, cifre și @/./+/-/_."

msgid "This value may contain only letters, numbers and @/./+/-/_ characters."
msgstr ""
"Această valoare poate conține numai litere, cifre și caracterele @/./+/-/_."

msgid "A user with that username already exists."
msgstr "Un utilizator cu acest nume există deja."

msgid "The two password fields didn't match."
msgstr "Câmpurile de parolă nu se potrivesc."

msgid "Email"
msgstr "E-mail"

msgid "First Name"
msgstr "Prenume"

msgid "Last Name"
msgstr "Nume"

msgid "Password"
msgstr "Parolă"

msgid "Leave blank if not changing."
msgstr "Lăsați liber dacă nu schimbați."

msgid "Password confirmation"
msgstr "Confirmare parolă"

msgid "Enter the same password as above, for verification."
msgstr "Introduceți aceeași parolă ca mai sus, pentru verificare."

msgid "Administrator"
msgstr "Administrator"

msgid "Administrators have full access to manage any object or setting."
msgstr "Administratorii pot gestiona orice obiect sau setare."

msgid "A group with that name already exists."
msgstr "Un grup cu acest nume există deja."

msgid "You cannot have multiple permission records for the same page."
msgstr ""
"Nu puteți avea înregistrări de permisiune multiple pentru aceeași pagină."

msgid "submitted notifications"
msgstr "notificări depuse"

msgid "Receive notification when a page is submitted for moderation"
msgstr "Primiți o notificare când o pagină este trimisă pentru moderare"

msgid "approved notifications"
msgstr "notificări aprobate"

msgid "Receive notification when your page edit is approved"
msgstr "Primiți o notificare când modificarea paginii dvs. este aprobată"

msgid "rejected notifications"
msgstr "notificări respinse"

msgid "Receive notification when your page edit is rejected"
msgstr "Primiți o notificare când modificarea paginii dvs. este respinsă"

msgid "updated comments notifications"
msgstr "notificări pentru comentarii actualizate"

msgid ""
"Receive notification when comments have been created, resolved, or deleted "
"on a page that you have subscribed to receive comment notifications on"
msgstr ""
"Primiți notificări atunci când comentariile au fost create, rezolvate sau "
"șterse pe o pagină la care v-ați abonat la notificări de comentarii"

msgid "preferred language"
msgstr "limba preferată"

msgid "Select language for the admin"
msgstr "Selectați limba pentru interfața de administrare"

