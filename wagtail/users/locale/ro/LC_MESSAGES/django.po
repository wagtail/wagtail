#, python-format
msgid "Assign role to 1 user"
msgid_plural "Assign role to %(counter)s users"
msgstr[0] "Atribuie rol la 1 utilizator"
msgstr[1] "Atribuie rol la %(counter)s utilizatori"
msgstr[2] "Atribuie rol la %(counter)s de utilizatori"

